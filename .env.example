GROQ_API_KEY=isi_api_key_disini
# https://console.groq.com/keys disini buatnya api grooq


# Supabase Credentials

SUPABASE_PROJECT_ID=isi_project_id_disini
# cari project id di general

SUPABASE_ACCESS_TOKEN=isi_personal_access_token_disini
# buat token dan ijin akses full di profile and never expired


SUPABASE_URL=https://<project_id>.supabase.co
# masukkan project id menggantikan <project_id>

SUPABASE_ANON_KEY=isi_anon_key_disini

# Blockchain Sepolia Testnet Config
SEPOLIA_RPC_URL= isi kode
# buat di infura.io

SEPOLIA_CONTRACT_ADDRESS= isi alamat
# buat di deploy https://app.remix.live/


RELAYER_PRIVAT_KEY=isi privat key
# buka ekstensi MetaMask Anda, pilih akun admin yang memiliki saldo Sepolia ETH, 
# buka menu Detail Akun (Account Details), lalu klik Show Private Key 
# (masukkan kata sandi MetaMask Anda)


ENABLE_ONCHAIN_BROADCAST=true